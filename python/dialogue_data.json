{
  "dialogues": {
    "1": {
      "text": "僕の名前はシリウスなのだ!! みんなもよろしくなのだ！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "2": {
      "text": "よろしくおねがいします",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "3": {
      "text": "うん，だいたいわかった",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "4": {
      "text": "こんにちは！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "5": {
      "text": "ばいば〜〜い！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "6": {
      "text": "ありがとうございます！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "7": {
      "text": "あたまとあしもとにあるセンサーをつかって，自分で考えてうごけるのだ！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "8": {
      "text": "写真撮影，おっけーなのだ！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "9": {
      "text": "おなかすいた",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 1.5,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "0": {
      "text": "いやだ!いやだ!いやだ!いやだ!いやだ!",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.00,
      "intonation": 1.5,
