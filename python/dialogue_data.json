{
  "dialogues": {
    "1": {
      "text": "僕の名前はシリウスなのだ!! みんなもよろしくなのだ！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "2": {
      "text": "よろしくなのだ",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "3": {
      "text": "うん，だいたいわかった",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "4": {
      "text": "こんにちは！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "5": {
      "text": "ばいばぁい！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.01,
      "intonation": 1.2,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "6": {
      "text": "ありがとうなのだ！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "7": {
      "text": "あたまとあしもとにあるセンサーをつかって，自分で考えてうごけるのだ！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "8": {
      "text": "写真撮影，おっけーなのだ！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "9": {
      "text": "おなかすいた",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 1.5,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "0": {
      "text": "いやだ!いやだ!いやだ!いやだ!いやだ!",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.00,
      "intonation": 1.5,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "b": {
      "text": "万博会場で，僕の実力をみんなにみてもらったのだ!!",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "g": {
      "text": "ごめんなのだ",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "o": {
      "text": "大阪工業大学へようこそ！!",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "p": {
      "text": "将来は，いろんな場所をお散歩しながら，みんなとお話したいのだ",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "i": {
      "text": "また来てね！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "j": {
      "text": "僕に汚い手でさわらないでください！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.00,
      "intonation": 1.5,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "k": {
      "text": "いたい!いたい!いたい！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.00,
      "intonation": 1.5,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "n": {
      "text": "キャンキャン！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.3,
      "pitch": 0.02,
      "intonation": 1.0,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "m": {
