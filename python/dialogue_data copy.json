{
  "dialogues": {
    "1": {
      "text": "僕の名前はシリウスなのだ!! みんなもよろしくなのだ！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "自己紹介"
    },
    "2": {
      "text": "坂本くん，おなかすいた",
      "enabled": true,
      "style_id": 42,
      "speed": 1.1,
      "pitch": 0.0,
      "intonation": 1.2,
      "vvm_model": "10.vvm",
      "description": "挨拶"
    },
    "3": {
      "text": "マネケンのワッフルが食べたい",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "発音練習"
    },
    "4": {
      "text": "キャンキャン！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.3,
      "pitch": 0.02,
      "intonation": 1.0,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "6": {
      "text": "ワンワン！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.3,
      "pitch": 0.02,
      "intonation": 1.0,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "5": {
      "text": "ありがとうございます",
      "enabled": true,
      "style_id": 42,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 1.5,
      "vvm_model": "10.vvm",
      "description": "お礼"
    },
    "7": {
      "text": "僕に汚い手でさわらないでください！",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.00,
      "intonation": 1.5,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "8": {
      "text": "めいどばい こたにりょうた!!",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.00,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "9": {
      "text": "共著者 坂本しんのすけ, 黒瀬太一",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.00,
      "intonation": 0.9,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "0": {
      "text": "いやだ!いやだ!いやだ!いやだ!いやだ!",
      "enabled": true,
      "style_id": 54,
      "speed": 1.0,
      "pitch": 0.00,
      "intonation": 1.5,
      "vvm_model": "13.vvm",
      "description": "日常挨拶"
    },
    "m": {
      "text": "まえだくんさあ",
      "enabled": true,
      "style_id": 42,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 1.2,
      "vvm_model": "10.vvm",
      "description": "お礼"
    },
    "n": {
      "text": "でてぃっくがこわれちゃった！",
      "enabled": true,
      "style_id": 42,
      "speed": 1.0,
      "pitch": 0.0,
      "intonation": 1.2,
      "vvm_model": "10.vvm",
      "description": "お礼"
    },
    "-": {
      "text": "へいしり！",
